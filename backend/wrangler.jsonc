{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "munnas-grooves-shared",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-23",
  "workers_dev": true,
  "vars": { "ALLOWED_ORIGIN": "https://navakanthboyina.github.io" },
  "ai": { "binding": "AI" },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "munnas-grooves",
    "database_id": "REPLACE_WITH_CREATED_D1_DATABASE_ID",
    "migrations_dir": "migrations"
  }],
  "triggers": { "crons": ["0 3 * * *"] }
}
